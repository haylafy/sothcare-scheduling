# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:pass@localhost:5432/sothcare_scheduling?schema=public"

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Public origin used to build booking links in emails/ICS files
APP_URL="https://app.sothcare.com"
# Where the module is mounted inside the Sothcare app ("" when standalone)
SCHEDULING_BASE_PATH=""
# 32-byte base64 key used to encrypt OAuth refresh tokens at rest.
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=""
# Shared secret for the cron endpoint (sent as Authorization: Bearer <secret>)
CRON_SECRET=""

# ---------------------------------------------------------------------------
# Google Calendar (Google Cloud console -> APIs & Services -> Credentials)
# Enable: Google Calendar API. Scopes: calendar.events, calendar.readonly
# Authorized redirect URI: {APP_URL}/api/calendars/google/callback
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---------------------------------------------------------------------------
# HubSpot (developer.hubspot.com -> your app -> Auth)
# Scopes: crm.objects.contacts.write, crm.objects.contacts.read
# Redirect URI: {APP_URL}/api/crm/hubspot/callback
# ---------------------------------------------------------------------------
HUBSPOT_CLIENT_ID=""
HUBSPOT_CLIENT_SECRET=""

# ---------------------------------------------------------------------------
# Email — sent from your own domain (sothcare.com)
# Option A: SMTP (Amazon SES SMTP, Hostinger, Google Workspace SMTP relay...)
# Option B: set MAIL_TRANSPORT=ses and use AWS credentials from the environment
# ---------------------------------------------------------------------------
MAIL_TRANSPORT="smtp"            # smtp | ses | log
MAIL_FROM="Sothcare <admin@sothcare.com>"
MAIL_REPLY_TO="admin@sothcare.com"
SMTP_HOST="email-smtp.us-east-1.amazonaws.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
AWS_REGION="us-east-1"
